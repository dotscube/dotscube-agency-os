# Frontend (safe to expose: the anon key is restricted by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# NEVER put the service-role key in a VITE_ variable. It belongs only in
# Supabase Edge Function secrets: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
